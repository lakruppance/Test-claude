# =============================================================================
# .env.example — liste complète des variables d'environnement.
# Ne jamais committer de vraies valeurs. Les secrets vivent dans :
#   - Vercel (frontend + routes API)      - Modal (workers Python)
#   - Trigger.dev (orchestration)         - GitHub Actions (déploiements CI)
# Préfixe NEXT_PUBLIC_ = exposé au navigateur : n'y mettre AUCUN secret.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development                      # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr
STAGING_BASIC_AUTH=                      # "utilisateur:motdepasse" ; protège le staging avant la phase 2
MAX_UPLOAD_BYTES=5368709120              # 5 Go

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # publique, protégée par la RLS
SUPABASE_SERVICE_ROLE_KEY=               # SECRET serveur/workers uniquement, jamais côté client
SUPABASE_DB_URL=                         # migrations et tests pgTAP (CI)
SUPABASE_JWT_SECRET=

# --- Stockage vidéo : Cloudflare R2 -----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=                             # https://<account_id>.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL_SECONDS=900
SOURCE_RETENTION_DAYS=7                  # suppression automatique des sources (règle de cycle de vie R2)
CLIP_RETENTION_DAYS=90

# --- Workers : Modal ---------------------------------------------------------
MODAL_TOKEN_ID=                          # CI uniquement (modal deploy)
MODAL_TOKEN_SECRET=
WORKER_ENDPOINT_URL=                     # URL du point d'entrée Modal
WORKER_SHARED_SECRET=                    # jeton partagé orchestrateur -> worker (openssl rand -hex 32)

# --- Orchestration : Trigger.dev (option A) ---------------------------------
TRIGGER_SECRET_KEY=                      # Vercel : clé de l'environnement Trigger.dev ciblé
TRIGGER_PROJECT_REF=
TRIGGER_ACCESS_TOKEN=                    # CI uniquement (trigger.dev deploy)

# --- Transcription -----------------------------------------------------------
TRANSCRIPTION_PROVIDER=assemblyai        # assemblyai | deepgram
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODELS=universal       # liste par ordre de préférence ; identifiant Universal-3.5 Pro à confirmer
DEEPGRAM_API_KEY=                        # repli optionnel
DEEPGRAM_MODEL=nova-3

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5
CLAUDE_MODEL_LIGHT=claude-haiku-4-5
CLAUDE_EFFORT=medium

# --- Règles de clips et limites (valeurs par défaut des workers) -----------
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=60
CLIPS_TO_RENDER=3
MAX_SOURCE_MINUTES=180
CLIP_STYLE_DEFAULT=impact                # impact | boite | epure

# --- Ingestion ---------------------------------------------------------------
YTDLP_ENABLED=true
YTDLP_PROXY_URL=                         # vide par défaut ; ne sera renseigné qu'avec accord explicite
GOOGLE_PICKER_API_KEY=                   # import Google Drive (clé restreinte au domaine)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
RSS_POLL_INTERVAL_MINUTES=30

# --- OAuth Google (connexion + YouTube) -------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=                    # chiffrement des jetons OAuth stockés (32 octets, base64)

# --- TikTok ------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# --- Stripe ------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=

# --- Emails (SMTP pour Supabase Auth) ---------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --- Monitoring --------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=                              # workers
SENTRY_AUTH_TOKEN=                       # CI : envoi des sourcemaps

# --- Limites et administration ----------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ADMIN_EMAILS=                            # liste séparée par des virgules
